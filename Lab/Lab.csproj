<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Lab</AssemblyName>
  </PropertyGroup>

  <!-- Teacher copy: the interns are built from source. -->
  <ItemGroup Condition="Exists('../Hidden/Hidden.csproj')">
    <ProjectReference Include="../Hidden/Hidden.csproj" />
  </ItemGroup>

  <!-- Student copy: the interns arrive compiled, in lib/Hidden.dll. -->
  <ItemGroup Condition="!Exists('../Hidden/Hidden.csproj')">
    <Reference Include="Hidden">
      <HintPath>../lib/Hidden.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
